 #if defined(__HAIKU__)
 #define RESOLV_CONF_PATH "/boot/system/settings/network/resolv.conf"
+#elif defined(__ANDROID__)
+/*
+ * Android has no /etc/resolv.conf and no public API for native code to
+ * query the active DNS servers.  The embedding app writes a resolv.conf
+ * style file (from ConnectivityManager/LinkProperties) and exports its
+ * path in SLIRP_RESOLV_CONF.  When the variable is unset or the file is
+ * missing/empty, well-known public resolvers are used instead of the
+ * 127.0.0.1 default (nothing listens there on Android).
+ */
+static const char *android_resolv_conf_path(void)
+{
+    const char *p = getenv("SLIRP_RESOLV_CONF");
+    return (p && *p) ? p : "/etc/resolv.conf";
+}
+#define RESOLV_CONF_PATH android_resolv_conf_path()
 #else
 #define RESOLV_CONF_PATH "/etc/resolv.conf"
 #endif
