--- qemu-11.1.3.orig/util/oslib-posix.c	2026-11-15 00:15:10
+++ qemu-11.1.3/util/oslib-posix.c	2026-11-15 00:16:38
@@ -61,6 +61,47 @@
 #include "qemu/memalign.h"
 #include "qemu/mmap-alloc.h"
 
+#ifdef __ANDROID__
+/*
+ * bionic has no POSIX shared memory (no /dev/shm).  Emulate shm_open() and
+ * shm_unlink() with regular files below $TMPDIR, which is the only
+ * guaranteed-writable place for an app-private process.
+ */
+static char *android_shm_path(const char *name)
+{
+    const char *tmpdir = getenv("TMPDIR");
+
+    while (name[0] == '/') {
+        ++name;
+    }
+    if (name[0] == '\0') {
+        errno = EINVAL;
+        return NULL;
+    }
+    if (!tmpdir || !tmpdir[0]) {
+        tmpdir = "/data/local/tmp";
+    }
+    return g_strdup_printf("%s/%s", tmpdir, name);
+}
+
+static int shm_unlink(const char *name)
+{
+    g_autofree char *fname = android_shm_path(name);
+
+    return fname ? unlink(fname) : -1;
+}
+
+static int shm_open(const char *name, int oflag, mode_t mode)
+{
+    g_autofree char *fname = android_shm_path(name);
+
+    if (!fname) {
+        return -1;
+    }
+    return open(fname, oflag | O_CLOEXEC, mode);
+}
+#endif /* __ANDROID__ */
+
